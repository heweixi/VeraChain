%% DataChain Rust 架构总览(精简,只画模块与数据流向;字段见分链路图 FLOW-A/B/C)
%% 渲染: npx -y @mermaid-js/mermaid-cli@11.4.2 -i docs/FLOW.mmd -o docs/FLOW.png -b white -s 3
%%{init: {"theme":"base","themeVariables":{"fontSize":"16px"},"flowchart":{"nodeSpacing":60,"rankSpacing":70,"curve":"basis"}}}%%
flowchart TB
    client(["客户端 / CLI"]):::ext

    subgraph API["API 层 (Axum)"]
        direction LR
        pubr["公开路由<br/>health / register / login / refresh"]:::api
        mw["auth_middleware<br/>JWT → Claims + RBAC"]:::api
    end
    client --> pubr
    client --> mw

    mw --> MD["元数据<br/>MetadataManager"]:::svc
    mw --> ID["链上身份 L1<br/>identity"]:::svc
    mw --> MINE["挖矿<br/>chain/mine"]:::svc
    mw --> ANCH["数据锚定 R5<br/>AnchorService"]:::svc

    MD -->|create 入 pending| CHAIN
    ID -->|key-tx 入 pending_key_tx| CHAIN
    CHAIN["Chain 内存<br/>blocks / pending / pending_key_tx"]:::core
    MINE --> CHAIN
    CHAIN -->|mine_block + PoW| BLOCK["Block<br/>merkle_root(metadata++key_tx)<br/>identity_snapshot_hash"]:::core
    BLOCK -->|commit_block 单事务| DB[("SQLite<br/>blocks / metadata投影 / users<br/>versions / aggregations<br/>anchor_outbox / revoked_refresh")]:::db

    MD -.读投影.-> DB
    ID -.读 replay_key_set.-> BLOCK
    DB --> EV["EventBus → WS 推送"]:::out
    DB --> P2P["P2P 广播/发现/最长链"]:::out
    BLOCK -.data_id.-> ANCH
    ANCH -->|签名+outbox| DB
    ANCH -->|worker 每30s 投递| EXT["外部认证链<br/>(单外链)"]:::ext

    NOTE["权威根 = 区块 + merkle_root + PoW<br/>投影/outbox/回执为派生或旁路<br/>可信根靠外链锚定(内部不共识)<br/>L2多外链/L3回写/L4切换/L5封存 未实现"]:::note
    DB -.- NOTE

